# Search Configuration
SEARCH_ENGINE=google
MAX_RESULTS_PER_SEARCH=10

# Scraping Settings
HEADLESS_MODE=true
TIMEOUT=30
DELAY_BETWEEN_REQUESTS=2

# Output Settings
OUTPUT_FORMAT=csv
OUTPUT_DIRECTORY=./output

# LinkedIn Settings (required for comment bot)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Comment Bot Settings
COMMENT_STYLE=professional
MAX_COMMENTS_PER_SESSION=10
MIN_DELAY_BETWEEN_COMMENTS=60
MAX_DELAY_BETWEEN_COMMENTS=180
